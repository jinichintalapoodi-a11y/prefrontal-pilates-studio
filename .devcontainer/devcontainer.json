{
  "name": "Neural Orchard — Private Pilot QA",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Private Neural Orchard QA preview",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postStartCommand": "bash .devcontainer/start-qa-preview.sh"
}
