# REVIEW-ONLY TEMPLATE. Not deployable until founder approvals.
name = "neural-orchard-feedback-email-qa"
main = "src/worker.js"
compatibility_date = "2026-11-14"
workers_dev = false
# Never point this Worker at the production domain or activate feedback here.
[vars]
ENABLE_EMAIL_FEEDBACK = "false"
ENABLE_SYNTHETIC_EMAIL_QA = "false"
ALLOWED_ORIGIN = "https://REPLACE-WITH-APPROVED-PRIVATE-TEST-ORIGIN.example"
# Supply FEEDBACK_RECIPIENT, FEEDBACK_SENDER, and QA_TOKEN as protected env settings.
# Founder-approved recipient: prefrontalpilates.feedback@gmail.com.
# Cloudflare account verification, sender-domain DNS and free-tier eligibility still NOT confirmed.
# Deployment remains forbidden until founder explicitly approves any required setup.
# Native Cloudflare Email Service binding; restrict to exactly one verified recipient.
[[send_email]]
name = "EMAIL"
destination_address = "prefrontalpilates.feedback@gmail.com"
[[ratelimits]]
name = "PILOT_RATE_LIMIT"
namespace_id = "321004"
[ratelimits.simple]
limit = 10
period = 60
